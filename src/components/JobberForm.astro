---
import { contact } from "@data/contact";

const { clienthubId, formUrl, workRequestUrl } = contact.jobber;
---

<div class="w-full" data-jobber-form data-clienthub-id={clienthubId} data-form-url={formUrl}>
  <div id={clienthubId} class="w-full"></div>
  <div class="jobber-form-placeholder bg-base-200 rounded-xl p-6 text-center animate-pulse motion-reduce:animate-none" role="status">
    <p class="text-base-content/50 text-sm">Loading estimate form…</p>
  </div>
  <div class="jobber-form-fallback hidden bg-base-200 rounded-xl p-6 text-center mt-4" role="status" data-jobber-fallback>
    <p class="text-base-content/70 mb-4">
      The form is taking a while to load. You can open it in its own tab instead.
    </p>
    <a href={workRequestUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      Open Estimate Request Form
    </a>
  </div>
  <p class="text-center text-sm text-base-content/60 mt-4">
    Having trouble with the form?
    <a href={workRequestUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">
      Open it in a new tab<span class="sr-only"> (opens in a new tab)</span>
    </a>
    or call <a href={`tel:+1${contact.phone.raw}`} class="underline hover:text-primary">{contact.phone.display}</a>.
  </p>
  <noscript>
    <div class="bg-base-200 rounded-xl p-6 text-center">
      <p class="text-base-content/70 mb-4">
        JavaScript is required to load the estimate form.
      </p>
      <a
        href={workRequestUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Open Estimate Request Form
      </a>
    </div>
  </noscript>
</div>

<script>
  function loadJobberForm(container: HTMLElement) {
    const clienthubId = container.dataset.clienthubId!;
    const formUrl = container.dataset.formUrl!;

    const stylesheet = document.createElement("link");
    stylesheet.rel = "stylesheet";
    stylesheet.media = "screen";
    stylesheet.href = "https://d3ey4dbjkt2f6s.cloudfront.net/assets/external/work_request_embed.css";
    document.head.appendChild(stylesheet);

    const script = document.createElement("script");
    script.src = "https://d3ey4dbjkt2f6s.cloudfront.net/assets/static_link/work_request_embed_snippet.js";
    script.setAttribute("clienthub_id", clienthubId);
    script.setAttribute("form_url", formUrl);
    script.async = true;
    const showFallback = () => container.querySelector(".jobber-form-fallback")?.classList.remove("hidden");
    // The form renders inside Jobber's own embed and its internal state is not visible to this
    // page, so we only react to what we can observe: the script failing, or not loading in time.
    let loaded = false;
    const timer = window.setTimeout(() => { if (!loaded) showFallback(); }, 12000);
    script.onerror = () => {
      window.clearTimeout(timer);
      container.querySelector(".jobber-form-placeholder")?.remove();
      showFallback();
    };
    script.onload = () => {
      loaded = true;
      window.clearTimeout(timer);
      container.querySelector(".jobber-form-placeholder")?.remove();
    };
    document.body.appendChild(script);
  }

  const containers = document.querySelectorAll<HTMLElement>("[data-jobber-form]");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            loadJobberForm(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "200px" }
    );
    containers.forEach((container) => observer.observe(container));
  } else {
    containers.forEach((container) => loadJobberForm(container));
  }
</script>
