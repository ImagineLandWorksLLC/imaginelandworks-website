---
import type { ServiceCity } from "@data/serviceArea";

interface Props {
  cities: ServiceCity[];
  /** Primary city to highlight (slug). Defaults to "lakeland". */
  primarySlug?: string;
  class?: string;
}

const { cities, primarySlug = "lakeland", class: className } = Astro.props;

// Center on the midpoint of the bounding box of all cities
const lats = cities.map((c) => c.lat);
const lngs = cities.map((c) => c.lng);
const centerLat = (Math.min(...lats) + Math.max(...lats)) / 2;
const centerLng = (Math.min(...lngs) + Math.max(...lngs)) / 2;

// Unique ID so multiple maps on a page don't collide
const mapId = `slm-${Math.random().toString(36).slice(2, 8)}`;

const pins = cities
  .filter((c) => c.showOnMap !== false)
  .map((c) => ({
    name: c.name,
    slug: c.slug,
    lat: c.lat,
    lng: c.lng,
    primary: c.slug === primarySlug,
  }));
---

<!-- Leaflet CSS — loaded once even if component is rendered multiple times -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<div
  id={mapId}
  class:list={[
    "w-full rounded-2xl overflow-hidden border border-base-300 shadow-md",
    "aspect-square lg:aspect-auto lg:h-full lg:min-h-96",
    className,
  ]}
  aria-label="Interactive map of Imagine Land Works service area in Polk County, FL"
  role="application"
>
  <!-- Shown while JS loads -->
  <div class="w-full h-full min-h-80 bg-base-200 flex items-center justify-center text-base-content/70 text-sm">
    Loading map…
  </div>
</div>

<script is:inline define:vars={{ mapId, pins, centerLat, centerLng }}>
(function () {
  const LEAFLET_JS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
  const MAPLIBRE_CSS = "https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css";
  const MAPLIBRE_JS = "https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js";
  const MAPLIBRE_LEAFLET_JS = "https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.4/leaflet-maplibre-gl.js";

  function webglSupported() {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  }

  // Resolves once the script has loaded (immediately if already present and
  // finished); rejects on network error so the caller can fall back.
  function loadScript(src) {
    return new Promise((resolve, reject) => {
      let s = document.querySelector(`script[src="${src}"]`);
      if (!s) {
        s = document.createElement("script");
        s.src = src;
        document.head.appendChild(s);
      }
      if (s.dataset.loaded) return resolve();
      s.addEventListener("load", () => { s.dataset.loaded = "1"; resolve(); });
      s.addEventListener("error", () => reject(new Error(src)));
    });
  }

  function loadStyle(href) {
    if (document.querySelector(`link[href="${href}"]`)) return;
    const l = document.createElement("link");
    l.rel = "stylesheet";
    l.href = href;
    document.head.appendChild(l);
  }

  function initMap() {
    const el = document.getElementById(mapId);
    if (!el || el.dataset.leafletInit) return;
    el.dataset.leafletInit = "1";
    el.innerHTML = ""; // clear placeholder

    const map = L.map(el, {
      center: [28.1, -82.5],
      zoom: 7,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    // OpenFreeMap "positron" vector style (open source, no API key) rendered
    // through MapLibre GL. Falls back to CARTO raster tiles when WebGL or the
    // MapLibre scripts are unavailable.
    if (window.maplibregl && L.maplibreGL && webglSupported()) {
      L.maplibreGL({
        style: "https://tiles.openfreemap.org/styles/positron",
        attribution:
          '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://openmaptiles.org/" target="_blank" rel="noopener">OpenMapTiles</a> Data from <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(map);
    } else {
      L.tileLayer(
        "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
        {
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: "abcd",
          maxZoom: 19,
        }
      ).addTo(map);
    }

    // Service-area shaded circle (~50-mile radius from Lakeland)
    const home = pins.find((p) => p.primary) ?? pins[0];
    L.circle([home.lat, home.lng], {
      radius: 130_000, // metres ≈ 80 miles
      color: "#2a7a99",
      weight: 2,
      dashArray: "8 5",
      fillColor: "#2a7a99",
      fillOpacity: 0.07,
    }).addTo(map);

    // City markers
    pins.forEach((pin) => {
      const size = pin.primary ? 16 : 11;
      const hit = 24; // minimum touch target size (WCAG 2.5.8)
      const bg = pin.primary ? "#e8952a" : "#2a7a99";
      const icon = L.divIcon({
        html: `<div style="width:${hit}px;height:${hit}px;display:flex;align-items:center;justify-content:center;">
          <div style="
            width:${size}px;height:${size}px;
            border-radius:50%;
            background:${bg};
            border:2.5px solid #fff;
            box-shadow:0 1px 5px rgba(0,0,0,.35);
          " title="${pin.name}, FL"></div>
        </div>`,
        iconSize: [hit, hit],
        iconAnchor: [hit / 2, hit / 2],
        className: "",
      });

      const marker = L.marker([pin.lat, pin.lng], {
        icon,
        alt: `${pin.name}, FL — view land clearing services`,
      }).addTo(map);
      marker.bindPopup(
        `<div style="font-family:sans-serif;min-width:130px;">
          <strong style="color:#2a7a99;">${pin.name}</strong><br>
          <a href="/service-area/${pin.slug}/"
             style="font-size:12px;color:#2a7a99;text-decoration:underline;">
            View services →
          </a>
        </div>`,
        { closeButton: false, maxWidth: 180 }
      );
    });
  }

  function loadLeafletThenInit() {
    // Leaflet is required; MapLibre is an enhancement — if it fails to load
    // (blocked, offline, no WebGL) initMap falls back to raster tiles.
    loadScript(LEAFLET_JS)
      .then(() => {
        if (!webglSupported()) return;
        loadStyle(MAPLIBRE_CSS);
        return loadScript(MAPLIBRE_JS).then(() => loadScript(MAPLIBRE_LEAFLET_JS));
      })
      .catch(() => {})
      .then(() => {
        if (window.L) initMap();
      });
  }

  // Defer loading Leaflet (and the map init) until the map is near the viewport,
  // so it doesn't ship on pages/scroll positions where it's never seen.
  const target = document.getElementById(mapId);
  if (target && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            loadLeafletThenInit();
            obs.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "300px" }
    );
    observer.observe(target);
  } else {
    loadLeafletThenInit();
  }
})();
</script>
