---
import BeforeAfterSlider from "@components/BeforeAfterSlider.astro";

interface Photo {
  src?: string;
  alt?: string;
  label: "Before" | "After";
}

interface Props {
  photos?: Photo[];
  serviceName: string;
}

const { photos, serviceName } = Astro.props;

const slots: Photo[] = photos && photos.length === 4
  ? photos
  : [
      { label: "Before", alt: `${serviceName} before photo 1` },
      { label: "After",  alt: `${serviceName} after photo 1`  },
      { label: "Before", alt: `${serviceName} before photo 2` },
      { label: "After",  alt: `${serviceName} after photo 2`  },
    ];

// Pair up as (Before, After) comparisons for the drag slider
const pairs = [
  { before: slots[0], after: slots[1] },
  { before: slots[2], after: slots[3] },
];
---

<section class="bg-base-100 py-20">
  <div class="container mx-auto px-6">

    <div class="text-center mb-12">
      <p class="text-secondary font-heading text-xl uppercase tracking-widest mb-2">
        The Results
      </p>
      <h2 class="text-primary font-heading">Before &amp; After</h2>
      <p class="text-base-content/60 text-sm mt-2">Drag the slider to compare</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {pairs.map((pair) => (
        <BeforeAfterSlider
          before={{ src: pair.before.src, alt: pair.before.alt }}
          after={{ src: pair.after.src, alt: pair.after.alt }}
        />
      ))}
    </div>

  </div>
</section>
