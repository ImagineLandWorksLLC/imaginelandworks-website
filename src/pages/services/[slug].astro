---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import ServiceHero from "@components/services/ServiceHero.astro";
import Breadcrumb from "@components/services/Breadcrumb.astro";
import ServiceProcess from "@components/services/ServiceProcess.astro";
import BeforeAfterGrid from "@components/services/BeforeAfterGrid.astro";
import PhotoGallery from "@components/services/PhotoGallery.astro";
import RelatedServices from "@components/services/RelatedServices.astro";
import ValueProps from "@components/ValueProps.astro";
import Testimonials from "@components/Testimonials.astro";
import ServiceArea from "@components/ServiceArea.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import { publishedProjects } from "@utils/siteProjects";
import FreeEstimateCTA from "@components/FreeEstimateCTA.astro";
import FAQSection from "@components/FAQSection.astro";
import Schema from "@components/Schema.astro";
import { serviceSections } from "@data/serviceSections";
import { reviews } from "@data/reviews";
import { serviceCities } from "@data/serviceArea";
import { contact, getSocialHref } from "@data/contact";
import { defaultValueProps } from "@data/valueProps";
import { buildBreadcrumbSchema, buildLocalBusinessSchema, SITE_URL } from "@utils/schema";
import PricingRange from "@components/services/PricingRange.astro";
import { getEstimateService } from "@data/estimator";

export function getStaticPaths() {
  return serviceSections.map((service) => ({
    params: { slug: service.anchor },
    props: { service },
  }));
}

const { service } = Astro.props;
// Dollar figures come only from owner-approved rates in estimator.ts.
const estimate = getEstimateService(service.anchor);
const pricing =
  estimate?.pricingStatus === "approved"
    ? {
        low: estimate.ratePerAcreLow,
        high: estimate.ratePerAcreHigh,
        unit: "per acre",
        note: `Planning range for typical Central Florida jobs, with a minimum project charge. Not a quote: actual pricing depends on vegetation, terrain, access, and debris removal. Request a free estimate for an exact number.`,
      }
    : null;
const relatedProjects = publishedProjects.filter(
  (p) => p.category === service.anchor || p.services?.includes(service.anchor),
);

const faqSchema = service.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: service.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    }
  : null;

const { "@context": _ctx, ...businessNode } = buildLocalBusinessSchema();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  serviceType: service.title,
  provider: businessNode,
  areaServed: serviceCities.filter((city) => city.showOnMap !== false).map((city) => ({
    "@type": "City",
    name: city.name,
  })),
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home",     item: `${SITE_URL}/` },
  { name: "Services", item: `${SITE_URL}/services/` },
  { name: service.title, item: `${SITE_URL}/services/${service.anchor}/` },
]);
---

<DefaultLayout title={service.seoTitle} description={service.seoDescription}>
  <Schema slot="head" schema={serviceSchema} />
  <Schema slot="head" schema={breadcrumbSchema} />
  {faqSchema && <Schema slot="head" schema={faqSchema} />}

  <ServiceHero
    eyebrow={service.eyebrow}
    title={service.title}
    shortDescription={service.shortDescription}
  />

  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services/" },
      { label: service.title },
    ]}
  />

  <!-- What's Included -->
  <section class="bg-base-100 py-20">
    <div class="container mx-auto px-6 max-w-3xl">
      <p class="text-secondary font-heading text-xl uppercase tracking-widest mb-2">
        What's Included
      </p>
      <h2 class="text-primary font-heading mb-8">{service.title} Service</h2>
      <ul class="space-y-4">
        {service.capabilities.map((item) => (
          <li class="flex items-start gap-4 text-base-content/80">
            <span class="mt-2 size-2.5 rounded-full bg-secondary shrink-0"></span>
            <span class="text-lg leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {pricing && (
    <PricingRange {...pricing} serviceName={service.title} />
  )}

  <ServiceProcess steps={service.processSteps} />

  <PhotoGallery
    photos={service.galleryPhotos}
    serviceName={service.title}
    ctaLabel="View Full Gallery"
    ctaHref="/gallery/"
  />

  {service.beforeAfterPhotos && (
    <BeforeAfterGrid photos={service.beforeAfterPhotos} serviceName={service.title} />
  )}

  {relatedProjects.length > 0 && (
    <section class="bg-base-200 py-16">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="text-primary font-heading text-center mb-10">{service.title} Projects</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}

  {service.anchor === "lawn-care" && (
    <section class="bg-base-100 py-10">
      <p class="text-center text-lg text-base-content/80 px-6">
        Looking for ongoing service? See our <a href="/maintenance-plans/" class="underline text-primary font-semibold">lawn maintenance plans</a>.
      </p>
    </section>
  )}

  <ValueProps items={defaultValueProps} />

  <Testimonials
    layout="featured"
    reviews={reviews}
    ctaLabel="Read More Reviews"
    ctaHref={getSocialHref("google")}
  />

  <ServiceArea
    cities={serviceCities}
    ctaLabel="See If We Service Your Area"
    ctaHref="/book/"
  />

  {service.faqs.length > 0 && (
    <FAQSection faqs={service.faqs} />
  )}

  <RelatedServices
    relatedSlugs={service.relatedServices}
    allServices={serviceSections}
  />

  <FreeEstimateCTA
    headline={`Get a Free ${service.title} Estimate`}
    subheadline="No Obligation. No Guesswork."
    body={`Ready to get started? We'll assess your property and give you a straight, honest estimate for your ${service.title.toLowerCase()} project, fast. Serving Central Florida and surrounding areas.`}
    ctaLabel="Request a Free Estimate"
    ctaHref="/book/"
    phone={contact.phone.display}
    phoneLabel="Call Us Today"
  />
</DefaultLayout>
