---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import Breadcrumb from "@components/services/Breadcrumb.astro";
import RelatedServices from "@components/services/RelatedServices.astro";
import FAQSection from "@components/FAQSection.astro";
import FreeEstimateCTA from "@components/FreeEstimateCTA.astro";
import Schema from "@components/Schema.astro";
import { resources, resourceCategoryLabels } from "@data/resources";
import { formatResourceDate, getPublishedResources, getRelatedResources } from "@utils/resources";
import { serviceSections } from "@data/serviceSections";
import { contact } from "@data/contact";
import { buildBreadcrumbSchema, SITE_URL } from "@utils/schema";

export function getStaticPaths() {
  return getPublishedResources(resources).map((resource) => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: resource.title,
  description: resource.seoDescription,
  author: { "@type": "Organization", name: "Imagine Land Works" },
  publisher: {
    "@type": "Organization",
    name: "Imagine Land Works",
    logo: { "@type": "ImageObject", url: `${SITE_URL}/images/ImagineLandWorks.png` },
  },
  datePublished: resource.publishDate,
  dateModified: resource.updatedDate ?? resource.publishDate,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}/resources/${resource.slug}/` },
};

const related = getRelatedResources(resource, resources);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home",      item: `${SITE_URL}/` },
  { name: "Resources", item: `${SITE_URL}/resources/` },
  { name: resource.title, item: `${SITE_URL}/resources/${resource.slug}/` },
]);

const faqSchema = resource.faqs && resource.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: resource.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    }
  : null;
---

<DefaultLayout
  title={resource.seoTitle}
  description={resource.seoDescription}
  ogType="article"
  publishedTime={resource.publishDate}
  modifiedTime={resource.updatedDate ?? resource.publishDate}
>
  <Schema slot="head" schema={articleSchema} />
  <Schema slot="head" schema={breadcrumbSchema} />
  {faqSchema && <Schema slot="head" schema={faqSchema} />}

  <section class="bg-base-100 py-16">
    <div class="container mx-auto px-6 max-w-3xl">
      <p class="text-secondary font-heading text-xl uppercase tracking-widest mb-2">
        {resourceCategoryLabels[resource.category]}
      </p>
      <h1 class="text-primary font-heading leading-tight">
        {resource.title}
      </h1>
      <p class="text-base-content/60 text-sm mt-4">
        Published <time datetime={resource.publishDate}>{formatResourceDate(resource.publishDate)}</time>
        {resource.updatedDate && (
          <>
            &middot; Updated <time datetime={resource.updatedDate}>{formatResourceDate(resource.updatedDate)}</time>
          </>
        )}
      </p>
    </div>
  </section>

  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: "Resources", href: "/resources/" },
      { label: resource.title },
    ]}
  />

  <section class="bg-base-100 py-20">
    <div class="container mx-auto px-6 max-w-3xl space-y-8">
      {resource.body.map((section) => (
        <div class="space-y-4">
          {section.heading && (
            <h2 class="text-primary font-heading text-2xl">{section.heading}</h2>
          )}
          {section.paragraphs.map((p) => (
            <p class="text-base-content/80 text-lg leading-relaxed">{p}</p>
          ))}
        </div>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-base-200 py-16" aria-labelledby="related-articles">
      <div class="container mx-auto px-6 max-w-3xl">
        <h2 id="related-articles" class="text-primary font-heading text-2xl mb-6">Related Articles</h2>
        <ul class="grid gap-4">
          {related.map((r) => (
            <li>
              <a href={`/resources/${r.slug}/`} class="block rounded-xl bg-base-100 p-5 shadow-sm hover:shadow-md no-underline">
                <span class="text-secondary font-heading text-xs uppercase tracking-widest">{resourceCategoryLabels[r.category]}</span>
                <span class="block font-heading text-primary text-lg mt-1">{r.title}</span>
                <span class="block text-sm text-base-content/70 mt-1">{r.shortDescription}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {resource.faqs && resource.faqs.length > 0 && (
    <FAQSection faqs={resource.faqs} />
  )}

  {resource.relatedServiceSlugs && (
    <RelatedServices
      relatedSlugs={resource.relatedServiceSlugs}
      allServices={serviceSections}
    />
  )}

  <FreeEstimateCTA
    headline="Get a Free Estimate for Your Property"
    subheadline="No Obligation. No Guesswork."
    body="Ready to find out what your land actually needs? We'll assess your property and give you a straight, honest estimate, fast."
    ctaLabel="Request a Free Estimate"
    ctaHref="/book/"
    phone={contact.phone.display}
    phoneLabel="Call Us Today"
  />
</DefaultLayout>
